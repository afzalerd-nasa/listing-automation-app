# GEMINI_API_KEY: Required for server-side Gemini AI product extraction, listing generation, and claim drafting.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AMAZON SP-API CONFIGURATION (Server-Side Only - Never exposed to browser)
# Mode: SANDBOX (default for safe verification) or LIVE_PRODUCTION
SP_API_MODE="SANDBOX"
SP_API_MARKETPLACE_ID="A21TJRUUN4KGV"
SP_API_REGION="eu-west-1"
SP_API_ENDPOINT_SANDBOX="https://sandbox.sellingpartnerapi-eu.amazon.com"
SP_API_ENDPOINT_PRODUCTION="https://sellingpartnerapi-eu.amazon.com"
LWA_CLIENT_ID="amzn1.application-oa2-client.example"
LWA_CLIENT_SECRET="YOUR_ENCRYPTED_LWA_CLIENT_SECRET"
LWA_REFRESH_TOKEN="YOUR_ENCRYPTED_LWA_REFRESH_TOKEN"
AWS_SELLING_PARTNER_ROLE_ARN="arn:aws:iam::123456789012:role/SellingPartnerAPIRole"
